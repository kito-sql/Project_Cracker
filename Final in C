#include <stdio.h>

typedef struct {
    int guess[3];
    int right;
    int misplaced;
    int wrong;
} A;

// verfication
void verifier(int code[3], int guess[3], int *right, int *misplaced, int *wrong) {
    *right = *misplaced = *wrong = 0;

    // count greens
    for (int i = 0; i < 3; i++) {
        if (code[i] == guess[i]) {
            (*right)++;
            guess[i] = -1;  // if green mark it 
            code[i] = -1;   // same
        }
    }

    // count blues 
    for (int i = 0; i < 3; i++) {
        if (guess[i] != -1) {  // if not green move on 
            for (int j = 0; j < 3; j++) {
                if (code[j] == guess[i] && code[j] != -1) {
                    (*misplaced)++;
                    code[j] = -1;  // mark it 
                    break;
                }
            }
        }
    }

    *wrong = 3 - *right - *misplaced;  // reds
}

int main() {
    A A1[50];  
    int count = 0;

    // input
    printf("Enter your input :\n");
    while (scanf("[%d %d %d] %d %d %d", 
                  &A1[count].wrong, &A1[count].right, &A1[count].misplaced,
                  &A1[count].guess[0], &A1[count].guess[1], &A1[count].guess[2]) == 6) {
        count++;
    }

    // brute force all combinaitions 
    for (int d0 = 0; d0 <= 9; d0++) {
        for (int d1 = 0; d1 <= 9; d1++) {
            for (int d2 = 0; d2 <= 9; d2++) {
                int code[3] = {d0, d1, d2};
                int valid = 1;

                //                  :/ 
                for (int i = 0; i < count; i++) {
                    int r, m, w;
                    verifier(code, A1[i].guess, &r, &m, &w);
                    if (r != A1[i].right || m != A1[i].misplaced || w != A1[i].wrong) {
                        valid = 0;
                        break;
                    }
                }

            
                if (valid) {
                    printf("Possible solution: [%d %d %d]\n", d0, d1, d2);
                }
            }
        }
    }

    return 0;
}



